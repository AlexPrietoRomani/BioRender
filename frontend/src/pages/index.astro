---
import Layout from '../layouts/Layout.astro';
import { BioRenderApp } from '../components/react/BioRenderApp';
---

<Layout title="BioRender MVP - Real-time Motion Capture & Retargeting">
	<main style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem;">
		{/* ── Encabezado Estilo Retro Terminal ── */}
		<header style="margin-bottom: 3rem; border-bottom: 1px solid #2e2e2e; padding-bottom: 1.5rem;">
			<h1 class="title-retro" style="font-size: 2rem; margin-bottom: 0.5rem;">
				BioRender_RT
			</h1>
			<p style="color: var(--text-muted); font-size: 0.85rem; letter-spacing: 0.05em;">
				[SYSTEM_STATUS: ACTIVE] // RETARGETING EN TIEMPO REAL CON INFERENCIA CPU LOCAL
			</p>
		</header>

		{/* ── Aplicación Principal ── */}
		<BioRenderApp client:only="react" />

		{/* ── Pie de página retro ── */}
		<footer style="margin-top: 4rem; border-top: 1px solid #2e2e2e; padding-top: 1.5rem; text-align: center; font-size: 0.7rem; color: var(--text-muted);">
			<p>BIORENDER PUNK SYSTEM v0.1.0 // CONSTRUIDO CON RUST, PYTHON Y ASTRO</p>
		</footer>
	</main>
</Layout>
